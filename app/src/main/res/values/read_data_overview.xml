<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="read_overview_today">Today</string>
    <string name="read_overview_today_time">Read today</string>
    <string name="read_overview_books">Books in shelf</string>
    <string name="read_overview_periods">Reading habits</string>
    <string name="read_overview_average_note">Daily average = daily detail total ÷ days with records. Daily details start with this version; past totals are not backfilled.</string>
    <string name="read_overview_trend_hint">Tap a day for its duration · hollow markers mean no reading</string>
    <string name="read_overview_trend_selected">%1$s · %2$s</string>
    <string name="read_overview_trend_scale">Scale: 0 — %1$s</string>
    <string name="read_overview_trend_empty">No reading in the last 7 days</string>
    <string name="read_overview_recent_empty">No recent reading yet</string>
    <string name="read_overview_saved_note">Saved reading time</string>
    <style name="ReadOverviewLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/secondaryText</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="ReadOverviewValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/primaryText</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">3</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="ReadOverviewHeading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/primaryText</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
